generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
  BKASH
  MOCK
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           BigInt   @id @default(autoincrement())
  publicId     String   @unique @default(cuid()) @map("public_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CUSTOMER)
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  orders Order[]

  @@map("users")
}

model Category {
  id       BigInt  @id @default(autoincrement())
  publicId String  @unique @default(cuid()) @map("public_id")
  name     String
  slug     String  @unique
  parentId BigInt? @map("parent_id")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          BigInt        @id @default(autoincrement())
  publicId    String        @unique @default(cuid()) @map("public_id")
  name        String
  sku         String        @unique
  description String?
  priceMinor  Int           @map("price_minor")
  currency    String        @default("USD") @db.Char(3)
  stock       Int
  status      ProductStatus @default(ACTIVE)
  categoryId  BigInt        @map("category_id")

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([categoryId, status, id])
  @@map("products")
}

model Order {
  id             BigInt      @id @default(autoincrement())
  publicId       String      @unique @default(cuid()) @map("public_id")
  userId         BigInt      @map("user_id")
  totalMinor     Int         @map("total_minor")
  currency       String      @db.Char(3)
  status         OrderStatus @default(PENDING)
  idempotencyKey String?     @unique @map("idempotency_key")

  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             BigInt @id @default(autoincrement())
  orderId        BigInt @map("order_id")
  productId      BigInt @map("product_id")
  quantity       Int
  unitPriceMinor Int    @map("unit_price_minor")
  subtotalMinor  Int    @map("subtotal_minor")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id            BigInt          @id @default(autoincrement())
  publicId      String          @unique @default(cuid()) @map("public_id")
  orderId       BigInt          @map("order_id")
  provider      PaymentProvider
  transactionId String          @map("transaction_id")
  status        PaymentStatus   @default(PENDING)
  amountMinor   Int             @map("amount_minor")
  currency      String          @db.Char(3)
  rawResponse   Json?           @map("raw_response")

  order Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([provider, transactionId])
  @@index([orderId])
  @@map("payments")
}

model ProcessedWebhookEvent {
  id          BigInt          @id @default(autoincrement())
  provider    PaymentProvider
  eventId     String          @map("event_id")
  processedAt DateTime        @default(now()) @map("processed_at") @db.Timestamptz

  @@unique([provider, eventId])
  @@map("processed_webhook_events")
}
