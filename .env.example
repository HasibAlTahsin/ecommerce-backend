NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://app:app@localhost:5432/ecommerce
REDIS_URL=redis://localhost:6379

# openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-characters-of-random
JWT_EXPIRES_IN=1h

STRIPE_ENABLED=true
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

BKASH_ENABLED=false
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

MOCK_PAYMENTS_ENABLED=true

# Email (verification PINs). Leave SMTP_HOST unset to use Ethereal test SMTP in dev.
# For production, set real SMTP credentials (e.g. Gmail App Password, SendGrid).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Comma-separated frontend origins allowed to call the API (CORS).
# Leave empty in development to allow all origins.
CORS_ORIGINS=
